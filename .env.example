ENVIRONMENT=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=events

# Required. Use a long random value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email confirmation. The sender must use a domain verified by Resend.
RESEND_API_KEY=
EMAIL_FROM=Events <accounts@example.com>
EMAIL_CONFIRMATION_URL=http://localhost:3000/confirm-email
EMAIL_CONFIRMATION_EXPIRES_IN=24h
EMAIL_RESEND_COOLDOWN=60s
